{% extends 'base.html.twig' %}

{% block title %}Account Settings - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/client_hub.css') }}">
    <link rel="stylesheet" href="{{ asset('css/settings.css') }}">
{% endblock %}

{% block body %}
    <div class="hub-wrapper">
        <aside class="hub-sidebar">
            <nav class="hub-menu">
                <a href="{{ path('app_client_dashboard') }}"><i class="fas fa-home"></i> Dashboard</a>
                <a href="{{ path('app_client_professionals') }}"><i class="fas fa-users"></i> Browse Pros</a>
                <a href="{{ path('app_client_settings') }}" class="active"><i class="fas fa-cog"></i> Settings</a>
            </nav>
        </aside>

        <div class="hub-main">
            <div class="hub-header">
                <h2>Manage your Account</h2>
            </div>

            <div class="settings-nav">
                <div class="nav-tab active">Profile Info & Security</div>
            </div>

            <div class="settings-card">
                
                {# Flash Notifications Display Block #}
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-error">{{ message }}</div>
                {% endfor %}

                <form action="{{ path('app_client_settings') }}" method="POST">
                    <h3><i class="fas fa-user-circle"></i> Personal Information</h3>
                    
                    <div class="profile-badge">
                        <img src="https://ui-avatars.com/api/?name={{ user.firstName }}+{{ user.lastName }}&background=2563eb&color=fff" class="profile-avatar-img" alt="avatar">
                        <div class="profile-info-display">
                            <p class="profile-name">{{ user.firstName }} {{ user.lastName }}</p>
                            <p class="profile-context">Account Profile Context: Client Hub</p>
                        </div>
                    </div>

                    <div class="form-row-flex">
                        <div class="form-group flex-item">
                            <label>First Name</label>
                            <input type="text" name="firstName" class="form-control" value="{{ user.firstName }}" required>
                        </div>
                        <div class="form-group flex-item">
                            <label>Last Name</label>
                            <input type="text" name="lastName" class="form-control" value="{{ user.lastName }}" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email Address (Cannot be modified)</label>
                        <input type="email" class="form-control" value="{{ user.email }}" disabled>
                    </div>

                    <div class="form-group">
                        <label>Region Base</label>
                        <input type="text" name="location" class="form-control" value="{{ user.location }}">
                    </div>

                    <hr class="section-divider">

                    <h3><i class="fas fa-lock"></i> Update Password</h3>
                    <p class="password-subtext">Leave these fields blank if you do not want to modify your current login password.</p>
                    
                    <div class="form-row-flex">
                        <div class="form-group flex-item">
                            <label>New Password</label>
                            <input type="password" name="new_password" class="form-control" placeholder="••••••••">
                        </div>
                        <div class="form-group flex-item">
                            <label>Confirm New Password</label>
                            <input type="password" name="confirm_password" class="form-control" placeholder="••••••••">
                        </div>
                    </div>

                    <div class="action-container">
                        <button type="submit" class="btn-submit">Save Settings Changes</button>
                    </div>
                </form>

                <hr class="section-divider">

                <div class="danger-zone">
                    <h4>Session Management</h4>
                    <p>Securely close your active browsing session right here.</p>
                    <a href="{{ path('app_logout') }}" class="btn-logout-action">Log Out</a>
                </div>
            </div>
        </div>
    </div>
    {% block javascripts %}
        <script src="{{ asset('js/jobPosting.js') }}"></script>
    {% endblock %}
{% endblock %}