{% extends 'base.html.twig' %}

{% block title %}Client Dashboard - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/client_hub.css') }}">
{% endblock %}

{% block body %}
    <div class="hub-wrapper">
        
        <aside class="hub-sidebar">
            <nav class="hub-menu">
                <a href="{{ path('app_client_dashboard') }}" class="active"><i class="fas fa-home"></i> Dashboard</a>
                <a href="{{ path('app_client_professionals') }}"><i class="fas fa-users"></i> Browse Pros</a>
                <a href="{{ path('app_client_settings') }}"><i class="fas fa-cog"></i> Settings</a>
            </nav>
        </aside>

        <div class="hub-main">
            <div class="hub-header">
                <h2>Welcome to your Dashboard</h2>
                <button class="btn btn-primary">+ Post a New Job</button>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-clipboard-list"></i></div>
                    <div class="stat-info">
                        <p>Jobs Posted</p>
                        <h3>5</h3>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-wallet"></i></div>
                    <div class="stat-info">
                        <p>Total Spent</p>
                        <h3>450 TND</h3>
                    </div>
                </div>
            </div>

            <div class="requests-section">
                <h3 style="margin-bottom: 15px;">Your Active Requests</h3>
                
                <div class="request-item">
                    <div>
                        <h4 style="margin-bottom: 5px;">Fix Leaking Kitchen Pipe</h4>
                        <span style="color: var(--text-muted); font-size: 0.85rem;"><i class="fas fa-clock"></i> Posted 2 days ago • Plumbing</span>
                    </div>
                    <div>
                        <span style="background: #fff3cd; color: #856404; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: bold;">Awaiting Pros</span>
                    </div>
                </div>

                <div class="request-item">
                    <div>
                        <h4 style="margin-bottom: 5px;">Deep Clean Living Room</h4>
                        <span style="color: var(--text-muted); font-size: 0.85rem;"><i class="fas fa-clock"></i> Posted 1 week ago • Cleaning</span>
                    </div>
                    <div>
                        <span style="background: #d4edda; color: #155724; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: bold;">In Progress</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}