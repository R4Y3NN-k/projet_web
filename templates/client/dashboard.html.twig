{% extends 'base.html.twig' %}

{% block title %}Client Dashboard - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/client_hub.css') }}">

{% endblock %}

{% block body %}
    <div class="hub-wrapper">
        
        <aside class="hub-sidebar">
            <nav class="hub-menu">
                <a href="{{ path('app_client_dashboard') }}" class="active"><i class="fas fa-home"></i> Dashboard</a>
                <a href="{{ path('app_client_professionals') }}"><i class="fas fa-users"></i> Browse Pros</a>
                <a href="{{ path('app_client_settings') }}"><i class="fas fa-cog"></i> Settings</a>
            </nav>
        </aside>

        <div class="hub-main">
            <div class="hub-header">
                <h2>Welcome back, {{ user.firstName }}! 👋</h2>
                <button class="btn btn-primary">+ Post a New Job</button>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-clipboard-list"></i></div>
                    <div class="stat-info">
                        <p>Jobs Posted</p>
                        <h3>{{ jobs_count }}</h3>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-wallet"></i></div>
                    <div class="stat-info">
                        <p>Total Spent</p>
                        <h3>{{ total_spent }} TND</h3>
                    </div>
                </div>
            </div>

            <div class="requests-section">
                <h3 style="margin-bottom: 15px;">Your Active Requests</h3>
                
                {% for command in requests %}
                    <div class="request-item" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e1e5eb; padding: 15px 0;">
                        <div style="flex: 1; padding-right: 20px;">
                            {# 💡 Handled potential fallback if you haven't migrated the title property yet #}
                            <h4 style="margin: 0 0 5px 0; font-size: 1.1rem; color: #1e293b;">
                                {{ command.title|default('Job Request #' ~ command.id) }}
                            </h4>
                            <p class="request-description">{{ command.description }}</p>
                            <span style="color: var(--text-muted); font-size: 0.85rem;">
                                <i class="fas fa-clock"></i> Posted {{ command.createdAt|date('d M Y') }} • <strong>{{ command.price }} TND</strong>
                            </span>
                        </div>
                        <div>
                            {# 🧠 Evaluates Null Provider Status logic seamlessly #}
                            {% if command.provider is null %}
                                <span class="badge status-awaiting"><i class="fas fa-hourglass-start"></i> Awaiting Pros</span>
                            {% else %}
                                <span class="badge status-progress"><i class="fas fa-tools"></i> Assigned ({{ command.status }})</span>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                        <i class="fas fa-folder-open" style="font-size: 2.5rem; margin-bottom: 15px; display:block; color: #cbd5e1;"></i>
                        You have no active commands right now.
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
{% endblock %}