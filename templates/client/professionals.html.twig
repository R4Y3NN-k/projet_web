                        {% endif %}
                    </div>
                {% else %}
                    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-muted);">
                        <i class="fas fa-user-slash" style="font-size: 2.5rem; display:block; margin-bottom:15px; color:#cbd5e1;"></i>
                        No professionals found matching those criteria.
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
    {% block javascripts %}
        <script src="{{ asset('js/jobPosting.js') }}"></script>
    {% endblock %}
{% endblock %}