{% extends 'base.html.twig' %}

{% block title %}Explore Services - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/ExploreServices.css') }}">
{% endblock %}

{% block body %}
    <main>


<section class="services-section">
    <div class="services-grid">
        
        <div class="service-card">
            <div class="service-image-container">
                <img src="{{ asset('img/plumbing.jpeg') }}" alt="Plumbing Services">
            </div>
            <h3>Plumbing</h3>
            <p>Leaks, clogs, pipe repairs, and full installations. Find certified plumbers ready to fix your water issues fast.</p>
            <a href="#" class="view-btn">View Experts</a>
        </div>

        <div class="service-card">
            <div class="service-image-container">
                <img src="{{ asset('img/electrical.jpeg') }}" alt="Electrical Services">
            </div>
            <h3>Electrical</h3>
            <p>Wiring, lighting fixtures, circuit breakers, and safe electrical repairs by licensed electricians.</p>
            <a href="#" class="view-btn">View Experts</a>
        </div>

        <div class="service-card">
            <div class="service-image-container">
                <img src="{{ asset('img/cleaning.jpeg') }}" alt="Cleaning Services">
            </div>
            <h3>Cleaning</h3>
            <p>Deep house cleaning, move-in/move-out cleans, and routine maid services for a spotless home.</p>
            <a href="#" class="view-btn">View Experts</a>
        </div>

        <div class="service-card">
            <div class="service-image-container">
                <img src="{{ asset('img/painter.jpeg') }}" alt="Painting Services">
            </div>
            <h3>Painting</h3>
            <p>Interior and exterior painting, wallpaper removal, and wall repairs for a fresh new look.</p>
            <a href="#" class="view-btn">View Experts</a>
        </div>

        <div class="service-card">
            <div class="service-image-container">
                <img src="{{ asset('img/carpentry.jpeg') }}" alt="Carpentry Services">
            </div>
            <h3>Carpentry</h3>
            <p>Custom furniture, door repairs, cabinetry, and structural woodworking from skilled carpenters.</p>
            <a href="#" class="view-btn">View Experts</a>
        </div>

        <div class="service-card">
            <div class="service-image-container">
                <img src="{{ asset('img/moving.jpeg') }}" alt="Moving Services">
            </div>
            <h3>Moving</h3>
            <p>Safe and efficient packing, loading, and transportation services to make your move stress-free.</p>
            <a href="#" class="view-btn">View Experts</a>
        </div>

    </div>
</section>
    </main>
{% endblock %}