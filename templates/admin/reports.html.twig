{% extends 'base.html.twig' %}

{% block title %}Manage Reports - Service TN Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/client_hub.css') }}">
    <style>
        .admin-wrapper {
            display: grid;
            grid-template-columns: 250px 1fr;
            min-height: calc(100vh - 80px);
            background: #f5f7fa;
        }
        .admin-sidebar {
            background: #ffffff;
            padding: 30px 20px;
            border-right: 1px solid #e1e5eb;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        }
        .admin-menu {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .admin-menu a {
            padding: 12px 15px;
            border-radius: 8px;
            color: #434343;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .admin-menu a:hover,
        .admin-menu a.active {
            background: #e6f2ff;
            color: #0369a1;
        }
        .admin-main {
            padding: 30px;
        }
        .admin-header h2 {
            font-size: 28px;
            color: #0f172a;
            margin-bottom: 10px;
        }
        .content-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            padding: 20px;
            overflow-x: auto; /* Handles horizontal overflow if descriptions are long */
        }
        .empty-state-container {
            text-align: center;
            padding: 50px 20px;
        }
        .empty-state-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }
        .empty-state-title {
            color: #0f172a;
            margin-bottom: 8px;
            font-size: 1.25rem;
            font-weight: 600;
        }
        .empty-state-text {
            color: #64748b;
            margin: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <nav class="admin-menu">
                <a href="{{ path('app_admin_dashboard') }}"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="{{ path('app_admin_users') }}"><i class="fas fa-users"></i> Manage Users</a>
                <a href="{{ path('app_admin_providers') }}"><i class="fas fa-briefcase"></i> Providers</a>
                <a href="{{ path('app_admin_clients') }}"><i class="fas fa-person"></i> Clients</a>
                <a href="{{ path('app_admin_jobs') }}"><i class="fas fa-tasks"></i> Jobs</a>
                <a href="{{ path('app_admin_categories') }}"><i class="fas fa-folder"></i> Categories</a>
                <a href="{{ path('app_admin_reports') }}" class="active"><i class="fas fa-file-alt"></i> Reports</a>
                <a href="{{ path('app_admin_settings') }}"><i class="fas fa-cog"></i> Settings</a>
            </nav>
        </aside>

        <div class="admin-main">
            <div class="admin-header">
                <h2>⚠️ Platform Reports</h2>
                <p style="color: var(--text-muted);">Review and resolve complaints or issues reported by users.</p>
            </div>

            <div class="content-card">
                {% if reports is not empty %}
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e1e5eb;">
                                <th style="text-align: left; padding: 12px; font-weight: 600;">ID</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Reason</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Description</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Reporter</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Reported User</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Job ID</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Created At</th>
                                <th style="text-align: left; padding: 12px; font-weight: 600;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for report in reports %}
                                <tr style="border-bottom: 1px solid #e1e5eb;">
                                    <td style="padding: 12px; color: var(--text-muted);">#{{ report.id }}</td>
                                    <td style="padding: 12px;"><strong>{{ report.reason }}</strong></td>
                                    <td style="padding: 12px; max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ report.description }}">
                                        {{ report.description }}
                                    </td>
                                    <td style="padding: 12px;">
                                        {% if report.reporter %}
                                            {{ report.reporter.firstName }} {{ report.reporter.lastName }}
                                        {% else %}
                                            <span style="color: var(--text-muted);">Unknown</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px;">
                                        {% if report.reportedUser %}
                                            {{ report.reportedUser.firstName }} {{ report.reportedUser.lastName }}
                                        {% else %}
                                            <span style="color: var(--text-muted);">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px;">
                                        {% if report.relatedCommand %}
                                            <span style="font-weight: 600;">#{{ report.relatedCommand.id }}</span>
                                        {% else %}
                                            <span style="color: var(--text-muted);">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px; font-size: 0.9rem;">
                                        {{ report.createdAt | date('Y-m-d H:i') }}
                                    </td>
                                    <td style="padding: 12px;">
                                        <span style="background: 
                                            {% if report.status == 'pending' or report.status == 'open' %} #fff7e6
                                            {% elseif report.status == 'reviewed' %} #e6f2ff
                                            {% else %} #f0f7f0
                                            {% endif %};
                                            color: 
                                            {% if report.status == 'pending' or report.status == 'open' %} #b45309
                                            {% elseif report.status == 'reviewed' %} #0369a1
                                            {% else %} #059669
                                            {% endif %};
                                            border-radius: 9999px; padding: 6px 12px; font-size: 0.8rem; font-weight: 500;">
                                            {{ report.status | capitalize }}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="empty-state-container">
                        <div class="empty-state-icon">🎉</div>
                        <h3 class="empty-state-title">No open reports found!</h3>
                        <p class="empty-state-text">Everything is clear. There are currently no pending items requiring administration review.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}