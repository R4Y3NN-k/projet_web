{% extends 'base.html.twig' %}

{% block title %}Sign Up{% endblock %}


{% block header_buttons %}{% endblock %}

{% block stylesheets %}
    
    <link rel="stylesheet" href="{{ asset('css/signUp.css') }}">
    <link rel="stylesheet" href="{{ asset('css/howItWorks.css') }}">
{% endblock %}

{% block body %}
    <main class="signup-split-container">
            
        <div class="signup-form-side">
            <div class="form-wrapper">
                <h2>Create your account</h2>
                <p class="subtitle">Join Service TN to connect with top-tier professionals and clients.</p>

                <div class="user-toggle signup-toggle">
                    <button type="button" id="signup-client-btn" class="toggle-btn active">I am a Client</button>
                    <button type="button" id="signup-provider-btn" class="toggle-btn">I am a Provider</button>
                </div>

                {{ form_start(form, {'attr': {'id': 'advanced-signup-form'}}) }}
                <div class="alert alert-danger">
                    {{ form_errors(form) }}
                </div>
                    
                    {# Hidden field to submit whether the user is registering as client or provider #}
                    {{ form_widget(form.userType, {'attr': {'id': 'userType', 'name': 'userType'}}) }}

                    <div class="form-grid">
                        <div class="input-group">
                            <label for="firstName">First Name</label>
                            {{ form_widget(form.firstName, {'attr': {'id': 'firstName', 'placeholder': 'John'}}) }}
                        </div>
                        <div class="input-group">
                            <label for="lastName">Last Name</label>
                            {{ form_widget(form.lastName, {'attr': {'id': 'lastName', 'placeholder': 'Doe'}}) }}
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="email">Email Address</label>
                        {{ form_widget(form.email, {'attr': {'id': 'email', 'placeholder': 'john.doe@example.com'}}) }}
                    </div>

                    <div class="form-grid">
                        <div class="input-group">
                            <label for="dob">Date of Birth</label>
                            {{ form_widget(form.dateOfBirth, {'attr': {'id': 'dob'}}) }}
                        </div>
                        <div class="input-group">
                            <label for="location">Location</label>
                            {{ form_widget(form.location, {'attr': {'id': 'location'}}) }}
                        </div>
                    </div>

                    <div id="provider-fields" class="hidden-section">
                        <div class="form-grid">
                            <div class="input-group">
                                <label for="serviceCategory">Service Category</label>
                                {{ form_widget(form.serviceCategory, {'attr': {'id': 'serviceCategory'}}) }}
                            </div>
                            <div class="input-group">
                                <label for="experience">Years of Experience</label>
                                {{ form_widget(form.yearsOfExperience, {'attr': {'id': 'experience', 'placeholder': 'e.g. 5', 'min': '0'}}) }}
                            </div>
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="address">Full Address</label>
                        {{ form_widget(form.FullAdress, {'attr': {'id': 'address', 'placeholder': 'e.g. Route El Ain, Sfax'}}) }}
                    </div>

                    <div class="form-grid">
                        <div class="input-group">
                            <label for="password">Password</label>
                            {{ form_widget(form.plainPassword, {'attr': {'placeholder': '••••••••'}}) }}
                        </div>
                        <div class="input-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn-large">Create Account</button>
                {{ form_end(form) }}
                <br>
                <p class="signup-link">Already have an account? <a href="#" class="login-trigger">Log In</a></p>
            </div>
        </div>

        <div class="signup-visual-side">
            <div class="visual-content">
                <div class="visual-img-container">
                    <img src="{{ asset('img/home_page.jpg') }}" alt="Join Service TN">
                </div>
                <h3>Fast, Insured, Expert Everyday Repairs.</h3>
                <p>Join thousands of Tunisians already using Service TN to get things done securely and professionally.</p>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/Signup.js') }}"></script>
    <script>
        function killModal() {
            const modal = document.getElementById('login-modal');
            if (modal) {
                modal.classList.remove('show-modal');
                modal.style.display = 'none';
            }
        }
        document.addEventListener('DOMContentLoaded', killModal);
        document.addEventListener('turbo:load', killModal);
    </script>
{% endblock %}