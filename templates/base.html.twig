<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Service TN{% endblock %}</title>
    
    {# Link to our global CSS #}
    <link rel="stylesheet" href="{{ asset('css/global.css') }}">
    
    {# Load the Login Modal CSS here so it works on every page #}
    <link rel="stylesheet" href="{{ asset('css/loginLogique.css') }}">
    
    {# Block for page-specific CSS #}
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% block header %}
    {% if app.user %}
        <header class="header dashboard-top-nav">
            <nav>
                <h1>SERVICE TN</h1>
                
                <div class="nav-center">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}">Admin Panel</a>
                    {% else %}
                        {% if not is_granted('ROLE_PROVIDER') %}
                            <a href="{{ path('app_page') }}">Home</a>
                        {% endif %}
                        <a href="{{ path('app_explore_services') }}">Explore Services</a>
                        {% if is_granted('ROLE_PROVIDER') %}
                            <a href="{{ path('app_provider_dashboard') }}">My Dashboard</a>
                        {% elseif is_granted('ROLE_CLIENT') %}
                            <a href="{{ path('app_client_dashboard') }}">My Dashboard</a>
                        {% else %}
                            <a href="{{ path('app_client_dashboard') }}">My Dashboard</a>
                        {% endif %}
                    {% endif %}
                </div>

                <div class="nav-right">
                    <button class="icon-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notification-dot"></span>
                    </button>
                    
                    <a href="{{ path('app_logout') }}" class="btn btn-outline" style="border-color: #ff4d4f; color: #ff4d4f;">Log Out</a>
                </div>
            </nav>
        </header>

    {% else %}
        <header class="header">
            <nav>
                <h1>SERVICE TN</h1>
                <a href="{{ path('app_page') }}">Home</a>
                <a href="{{ path('app_explore_services') }}">Explore Services</a>
                <a href="{{ path('app_how_it_works') }}">How it works</a>
                <div class="nav-right">
                    {# Notice I added the 'login-trigger' class here just in case! #}
                    <button class="btn btn-outline login login-trigger" id="login-btn">Login</button>
                    <a href="{{ path('app_sign_up') }}"> <button class="btn btn-primary signUp">Sign Up</button></a>
                </div>
            </nav>
        </header>
    {% endif %}
{% endblock %}

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-about">
                <h2 class="logo">Service TN</h2>
                <p>
                    Helping you find an expert for your daily needs
                </p>
                <div class="social-icons">
                    <span>🌐</span>
                    <span>💬</span>
                    <span>✳️</span>
                </div>
            </div>

            <div class="footer-column">
                <h3>ServiceTN</h3>
                <ul>
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Partnerships</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Support</h3>
                <ul>
                    <li><a href="#">Help Center</a></li>
                    <li><a href="#">Trust & Safety</a></li>
                    <li><a href="#">Selling on SeviceTN</a></li>
                    <li><a href="#">Buying on ServiceTN</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Categories</h3>
                <ul>
                    <li><a href="#">Painting</a></li>
                    <li><a href="#">Cleaning</a></li>
                    <li><a href="#">Carpentry</a></li>
                    <li><a href="#">Plumbing</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 ServiceTN Inc. All rights reserved.</p>
            <div class="footer-links">
                <a href="#">Terms of Service</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Accessibility</a>
            </div>
        </div>
    </footer>

{# Only render the login modal if the user is NOT logged in #}
{% if not app.user %}
    
    <div id="login-modal" class="modal-overlay {% if error is defined and error and app.request.attributes.get('_route') != 'app_sign_up' %}show-modal{% endif %}">
        <div class="modal-content">
            <h2>Welcome Back</h2>

            
            {% if error is defined and error %}
                <div class="alert alert-danger" style="color: #e63946; background: #ffe3e3; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
            
            <form id="ajax-login-form" action="{{ path('app_login') }}" method="post">
                <input type="email" id="username" name="_username" placeholder="Email address" value="{{ last_username|default('') }}" required autocomplete="email" autofocus>
                <input type="password" id="password" name="_password" placeholder="Password" required autocomplete="current-password">
                <input type="hidden" name="_csrf_token" id="csrf-token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="submit-btn">Log In</button>
            </form>
            <p class="signup-link">Don't have an account? <a href="{{ path('app_sign_up') }}">Sign Up</a></p>
        </div>
    </div>
{% endif %}

    {% block javascripts %}
        <script src="{{ asset('js/loginLogique.js') }}"></script>
        <script src="{{ asset('js/redirection.js') }}"></script>
    {% endblock %}
</body>
</html>