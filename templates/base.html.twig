<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Service TN{% endblock %}</title>
    
    {# Link to our global CSS #}
    <link rel="stylesheet" href="{{ asset('css/global.css') }}">
    
    {# Load the Login Modal CSS here so it works on every page #}
    <link rel="stylesheet" href="{{ asset('css/loginLogique.css') }}">
    
    {# Block for page-specific CSS #}
    {% block stylesheets %}{% endblock %}
</head>
<body>

    <header class="header">
        <nav>
            <h1>SERVICE TN</h1>
            <a href="{{ path('app_page') }}">Home</a>
            <a href="{{ path('app_explore_service') }}">Explore Services</a>
            <a href="{{ path('app_how_it_works') }}">How it works</a>
            <div class="nav-right">
                {# Notice I added the 'login-trigger' class here just in case! #}
                <button class="btn btn-outline login login-trigger" id="login-btn">Login</button>
               <a href="{{ path('app_sign_up') }}"> <button class="btn btn-primary signUp">Sign Up</button></a>
            </div>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>


<footer class="footer">
        <div class="footer-container">
            <div class="footer-about">
                <h2 class="logo">Service TN</h2>
                <p>
                    Helping you find an expert for your daily needs
                </p>
                <div class="social-icons">
                    <span>🌐</span>
                    <span>💬</span>
                    <span>✳️</span>
                </div>
            </div>

            <div class="footer-column">
                <h3>ServiceTN</h3>
                <ul>
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Partnerships</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Support</h3>
                <ul>
                    <li><a href="#">Help Center</a></li>
                    <li><a href="#">Trust & Safety</a></li>
                    <li><a href="#">Selling on SeviceTN</a></li>
                    <li><a href="#">Buying on ServiceTN</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Categories</h3>
                <ul>
                    <li><a href="#">Painting</a></li>
                    <li><a href="#">Cleaning</a></li>
                    <li><a href="#">Carpentry</a></li>
                    <li><a href="#">plumbery</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 ServiceTN Inc. All rights reserved.</p>
            <div class="footer-links">
                <a href="#">Terms of Service</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Accessibility</a>
            </div>
        </div>
    </footer>

    <div id="login-modal" class="modal-overlay">
        <div class="modal-content">
            <h2>Welcome Back</h2>
            <form>
                <input type="email" placeholder="Email address" required>
                <input type="password" placeholder="Password" required>
                <button type="submit" class="submit-btn">Log In</button>
            </form>
            <p class="signup-link">Don't have an account? <a href="{{ path('app_sign_up') }}">Sign Up</a></p>
        </div>
    </div>

    {% block javascripts %}
        <script src="{{ asset('js/loginLogique.js') }}"></script>
    {% endblock %}
</body>
</html>