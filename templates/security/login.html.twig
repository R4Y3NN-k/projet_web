{% extends 'base.html.twig' %}

{% block title %}Log in! - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/loginPage.css') }}">
{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-card">
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div style="margin-bottom: 20px; padding: 10px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; border-radius: 6px; font-size: 0.9rem;">
                    You are logged in as <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}" style="color: #15803d; font-weight: bold;">Logout</a>
                </div>
            {% endif %}

            <h1>Please sign in</h1>
            
            <div class="form-group">
                <label for="inputEmail">Email Address</label>
                {# FIXED: Changed name="email" to name="_username" #}
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" placeholder="name@domain.com" required autofocus>
            </div>
            
            <div class="form-group">
                <label for="inputPassword">Password</label>
                {# FIXED: Changed name="password" to name="_password" to strictly align with Symfony standards #}
                <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" placeholder="••••••••" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn-login" type="submit">
                Sign in
            </button>
        </form>
    </div>
</div>
{% endblock %}