{% extends 'base.html.twig' %}

{% block title %}Provider Dashboard - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/client_hub.css') }}">
{% endblock %}

{% block body %}
    <div class="hub-wrapper">
        <aside class="hub-sidebar">
            <nav class="hub-menu">
                <a href="{{ path('app_provider_dashboard') }}" class="active"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="{{ path('app_provider_jobs') }}"><i class="fas fa-search"></i> Find Work</a>
                <a href="{{ path('app_provider_settings') }}"><i class="fas fa-user-cog"></i> Settings</a>
            </nav>
        </aside>

        <div class="hub-main">
            <div class="hub-header">
                <h2>Provider Console 🛠️</h2>
                <a href="{{ path('app_provider_jobs') }}" class="btn btn-primary">Browse Available Jobs</a>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-coins"></i></div>
                    <div class="stat-info">
                        <p>Total Earned</p>
                        <h3>{{ totalEarned | number_format(2, '.', ',') }} TND</h3>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-check-double"></i></div>
                    <div class="stat-info">
                        <p>Jobs Completed</p>
                        <h3>{{ jobsCompleted }}</h3>
                    </div>
                </div>
            </div>

            <div class="requests-section">
                <h3 style="margin-bottom: 15px;">Your Current Gigs</h3>
                {% if currentGigs|length > 0 %}
                    {% for gig in currentGigs %}
                        <div class="request-item">
                            <div>
                                <h4 style="margin-bottom: 5px;">{{ gig.title }}</h4>
                                <span style="color: var(--text-muted); font-size: 0.85rem;">Client: {{ gig.client.userAccount.firstName }} {{ gig.client.userAccount.lastName }} • Status: {{ gig.status }}</span>
                                <p style="margin-top: 5px; color: var(--text-main); font-size: 0.9rem;">{{ gig.description }}</p>
                            </div>
                            <div style="text-align: right;">
                                <h4 style="color: var(--primary); margin-bottom: 10px;">{{ gig.price }} TND</h4>
                                <button class="btn btn-outline" style="font-size: 0.8rem;" data-status="{{ gig.status }}">{{ gig.status === 'Assigned' ? 'Start Work' : 'Complete Job' }}</button>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div style="padding: 20px; text-align: center; color: var(--text-muted);">
                        <p>No active gigs. <a href="{{ path('app_provider_jobs') }}" style="color: var(--primary); font-weight: bold;">Browse jobs</a> to find work!</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}