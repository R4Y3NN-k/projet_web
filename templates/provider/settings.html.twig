{% extends 'base.html.twig' %}

{% block title %}Provider Settings - Service TN{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/client_hub.css') }}">
    <style>
        .settings-nav {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            border-bottom: 2px solid #e1e5eb;
        }
        .nav-tab {
            padding: 10px 5px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            border-bottom: 3px solid transparent;
            cursor: pointer;
        }
        .nav-tab.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }
        .danger-zone {
            margin-top: 50px;
            padding: 20px;
            border: 1px solid #ffccc7;
            background-color: #fff1f0;
            border-radius: 12px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="hub-wrapper">
        <aside class="hub-sidebar">
            <nav class="hub-menu">
                <a href="{{ path('app_provider_dashboard') }}"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="{{ path('app_provider_jobs') }}"><i class="fas fa-search"></i> Find Work</a>
                <a href="{{ path('app_provider_settings') }}" class="active"><i class="fas fa-user-cog"></i> Settings</a>
            </nav>
        </aside>

        <div class="hub-main">
            <div class="hub-header">
                <h2>Professional Profile Settings 🛠️</h2>
            </div>

            <div class="settings-nav">
                <div class="nav-tab active">Professional Info</div>
            </div>

            <div class="settings-card">
                <form method="post" action="{{ path('app_provider_settings') }}">
                    <h3 style="margin-bottom: 20px;"><i class="fas fa-id-card"></i> Identity & Service</h3>
                    
                    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px; padding: 20px; background: #f0f7ff; border: 1px dashed var(--primary); border-radius: 10px;">
                        <img src="https://ui-avatars.com/api/?name=Ahmed+M&background=059669&color=fff" style="width: 70px; border-radius: 50%;">
                        <div>
                            <button type="button" class="btn btn-primary" style="padding: 8px 15px; font-size: 0.8rem;">Upload Work Photo</button>
                            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px;">Show your face or your team. It increases hire rates by 40%!</p>
                        </div>
                    </div>

                    <div style="display: grid; gap: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 20px;">
                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" name="firstName" class="form-control" value="{{ user.firstName }}">
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" name="lastName" class="form-control" value="{{ user.lastName }}">
                        </div>
                    </div>

                    <div style="display: flex; gap: 20px;">
                        <div class="form-group" style="flex: 1;">
                            <label>Primary Category</label>
                            <select name="category" class="form-control">
                                {% for category in categories %}
                                    <option value="{{ category.id }}" {{ provider.category and provider.category.id == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label>Years of Experience</label>
                            <input type="number" name="yearsOfExperience" class="form-control" min="0" value="{{ provider.yearsOfExperience }}">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Working Region</label>
                        <select name="location" class="form-control">
                            {% for location in locations %}
                                <option value="{{ location.id }}" {{ user.location and user.location.id == location.id ? 'selected' : '' }}>{{ location.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <hr style="border: 0; border-top: 1px solid #e1e5eb; margin: 40px 0;">

                    <h3 style="margin-bottom: 20px;"><i class="fas fa-lock"></i> Security</h3>
                    
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" class="form-control" value="{{ user.email }}" readonly style="background: #eee; cursor: not-allowed;">
                        <small>Contact support to change your registered professional email.</small>
                    </div>

                    <div style="display: flex; gap: 20px;">
                        <div class="form-group" style="flex: 1;">
                            <label>New Password</label>
                            <input type="password" name="new_password" class="form-control">
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label>Confirm Password</label>
                            <input type="password" name="confirm_password" class="form-control">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 15px; font-weight: bold;">Save Professional Profile</button>
                </form>

                <div class="danger-zone">
                    <h4 style="color: #cf1322; margin-bottom: 10px;">Pause Account</h4>
                    <p style="font-size: 0.9rem; color: #434343; margin-bottom: 15px;">Taking a vacation? You can hide your profile from search results instead of deleting it.</p>
                    <button class="btn btn-outline" style="border-color: #faad14; color: #faad14;">Go Offline</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}