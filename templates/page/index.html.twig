{% extends 'base.html.twig' %}

{% block title %}Service TN - Home{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/Home.css') }}">
    <link rel="stylesheet" href="{{ asset('css/loginLogique.css') }}">
{% endblock %}

{% block body %}
    <section>  
        <h1>Any Service</h1>
        <h3>Fast, Insured, Expert Everyday Repairs</h3>
        
        {# HTML Form targeting the browse professionals route using standard GET parameters #}
        <form action="{{ path('app_client_professionals') }}" method="get">
            <div>
                <input type="text" name="query" placeholder="What service do you need? (e.g. Plumber)">
                <select name="location" id="location">
                    <option value="">All Regions</option>
                    <option value="Tunis">Tunis</option>
                    <option value="Sousse">Sousse</option>
                    <option value="Sfax">Sfax</option>
                    <option value="Ariana">Ariana</option>
                    <option value="Béja">Béja</option>
                    <option value="Bizerte">Bizerte</option>
                    <option value="Gabès">Gabès</option>
                    <option value="Gafsa">Gafsa</option>
                    <option value="Kairouan">Kairouan</option>
                    <option value="Kasserine">Kasserine</option>
                    <option value="Kebili">Kebili</option>
                    <option value="Mahdia">Mahdia</option>
                    <option value="Manouba">Manouba</option>
                    <option value="Medenine">Medenine</option>
                    <option value="Monastir">Monastir</option>
                    <option value="Nabeul">Nabeul</option>
                    <option value="Sidi Bouzid">Sidi Bouzid</option>
                    <option value="Siliana">Siliana</option>
                    <option value="Tataouine">Tataouine</option>
                    <option value="Tozeur">Tozeur</option>
                    <option value="Zaghouan">Zaghouan</option>
                    <option value="Ben Arous">Ben Arous</option>
                    <option value="Kef">Kef</option>
                    <option value="Jendouba">Jendouba</option>
                </select>
                <button type="submit">Search</button>
            </div> 
        </form>
    </section>

    <section>
        <h1>Popular Categories</h1>
        <div class="categories-wrapper">
            <div class="categories">
                {% for category in categories %}
                    {# Clicking a category card auto-searches for that category id #}
                    <a href="{{ path('app_client_professionals', {'category': category.id}) }}" class="category" style="text-decoration: none; color: inherit; display: inline-block;">
                        <p>{{ category.name }}</p>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section>
        <h1>Top Providers</h1>
        <div class="providers">
            {% for provider in providers %}
                <div class="provider">
                    <p style="font-weight: bold; margin-bottom: 2px;">{{ provider.userAccount.firstName }} {{ provider.userAccount.lastName }}</p>
                    <span>
                        <i class="fas fa-star" style="color: #f1c40f;"></i> 
                        {{ provider.category.name|default('Professional') }} ({{ provider.yearsOfExperience }} years exp)
                    </span>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}