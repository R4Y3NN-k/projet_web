{% extends 'base.html.twig' %}

{% block title %}Service TN - Home{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/Home.css') }}">
    <link rel="stylesheet" href="{{ asset('css/loginLogique.css') }}">
{% endblock %}

{% block body %}
    <section>  
        <h1>Any Service</h1>
        <h3>Fast, Insured, Expert Everyday Repairs</h3>
        
        {# HTML Form targeting the browse professionals route using standard GET parameters #}
        <form action="{{ path('app_client_professionals') }}" method="get">
            <div>
                {# CHANGED: Replaced search text input with a dynamic Category dropdown #}
                <select name="category" id="category">
                    <option value="">Select a service category...</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>

                {# CHANGED: Replaced hardcoded options with an elegant database loop #}
                <select name="location" id="location">
                    <option value="">All Regions</option>
                    {% for loc in locations %}
                        {# Matches either loc.name or loc.id depending on how your search filter processes locations #}
                        <option value="{{ loc.name }}">{{ loc.name }}</option>
                    {% endfor %}
                </select>
                
                <button type="submit">Search</button>
            </div> 
        </form>
    </section>

    <section>
        <h1>Popular Categories</h1>
        <div class="categories-wrapper">
            <div class="categories">
                {% for category in categories %}
                    {# Clicking a category card auto-searches for that category id #}
                    <a href="{{ path('app_client_professionals', {'category': category.id}) }}" class="category" style="text-decoration: none; color: inherit; display: inline-block;">
                        <p>{{ category.name }}</p>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section>
        <h1>Top Providers</h1>
        <div class="providers">
            {% for provider in providers %}
                <div class="provider">
                    <p style="font-weight: bold; margin-bottom: 2px;">{{ provider.userAccount.firstName }} {{ provider.userAccount.lastName }}</p>
                    <span>
                        <i class="fas fa-star" style="color: #f1c40f;"></i> 
                        {{ provider.category.name|default('Professional') }} ({{ provider.yearsOfExperience }} years exp)
                    </span>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}